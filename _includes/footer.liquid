<footer class="{% if site.footer_fixed %}fixed-bottom{% else %}sticky-bottom mt-5{% endif %}" role="contentinfo">
  {% if site.newsletter.enabled and site.footer_fixed == false %}
    {% include scripts/newsletter.liquid %}
  {% endif %}
  <div class="container footer-content">
    <span
      >&copy; {{ site.time | date: '%Y' }}
      {{ site.first_name }}
      {{ site.middle_name }}
      {{ site.last_name }}. {{ site.footer_text -}}
    </span>
    <span>
      <a href="{{ '/privacy/' | relative_url }}">Privacy & analytics</a>
      {% if site.impressum_path %}
        &middot; <a href="{{ site.impressum_path | relative_url }}">Impressum</a>
      {% endif %}
      {% if site.last_updated %}
        &middot; Updated {{ site.time | date: '%B %Y' }}
      {% endif %}
    </span>
  </div>
</footer>
