<div class="news">
  {% if site.news != blank %}
    {% assign news = site.news | reverse %}
    {% assign news_size = site.news | size %}
    {% if include.limit and site.announcements.limit %}
      {% assign news_limit = site.announcements.limit %}
    {% else %}
      {% assign news_limit = news_size %}
    {% endif %}
    <div class="table-responsive">
      <table class="table table-sm table-borderless">
        {% for item in news limit: news_limit %}
          {% assign date_format = item.date_format | default: '%b %d, %Y' %}
          <tr>
            <th scope="row" style="width: 20%">{{ item.date | date: date_format }}</th>
            <td>
              {% if item.inline %}
                {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
              {% else %}
                <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
              {% endif %}
            </td>
          </tr>
        {% endfor %}
      </table>
    </div>
    {% if include.limit and news_size > news_limit %}
      <p>
        <button
          class="profile-link-primary"
          type="button"
          data-toggle="collapse"
          data-target="#older-news"
          aria-expanded="false"
          aria-controls="older-news"
        >
          Older news
        </button>
      </p>
      <div class="collapse" id="older-news">
        <div class="table-responsive">
          <table class="table table-sm table-borderless">
            {% for item in news offset: news_limit %}
              {% assign date_format = item.date_format | default: '%b %d, %Y' %}
              <tr>
                <th scope="row" style="width: 20%">{{ item.date | date: date_format }}</th>
                <td>
                  {% if item.inline %}
                    {{ item.content | remove: '<p>' | remove: '</p>' | emojify }}
                  {% else %}
                    <a class="news-title" href="{{ item.url | relative_url }}">{{ item.title }}</a>
                  {% endif %}
                </td>
              </tr>
            {% endfor %}
          </table>
        </div>
      </div>
    {% endif %}
  {% else %}
    <p>No news so far.</p>
  {% endif %}
</div>
