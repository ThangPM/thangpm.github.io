<section
  class="hero-scene workbench"
  data-document-scene
  data-active-stage="sources"
  data-running="false"
  aria-labelledby="scene-heading"
>
  <div class="scene-heading">
    <div>
      <p class="section-label">Models, tools &amp; evaluation</p>
      <h2 id="scene-heading">From tasks to useful results</h2>
    </div>
  </div>
  <p class="post-description">Explore common AI workflow patterns, not an Adobe system architecture. The steps vary by task.</p>
  <div class="scene-body">
    <div
      class="scene-viewport"
      tabindex="0"
      role="region"
      aria-label="Illustrative AI task workflow; scroll horizontally on small screens"
    >
      <div class="scene-canvas">
        <svg class="scene-illustration workbench-illustration" viewBox="0 0 1000 335" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="scene-halo">
              <stop offset="0" stop-color="currentColor" stop-opacity=".2"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="scene-card-light" x2="1" y2="1">
              <stop stop-color="currentColor" stop-opacity=".1"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="scene-surface" x1="0" y1="0" x2="0" y2="1">
              <stop stop-color="currentColor" stop-opacity=".1"/>
              <stop offset="1" stop-color="currentColor" stop-opacity=".015"/>
            </linearGradient>
            <marker id="scene-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M1 1L9 5L1 9" class="scene-arrowhead"/>
            </marker>
            <g id="scene-document-token" class="scene-token-drawing">
              <path class="scene-token-surface" d="M-10-14H4L10-8V14H-10ZM4-14V-8H10"/>
              <path d="M-5-3H5M-5 2H5M-5 7H2"/>
            </g>
            <g id="scene-chunk-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-17" y="-10" width="34" height="20" rx="4"/>
              <path d="M-11-3H11M-11 3H5"/>
            </g>
            <g id="scene-vector-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-20" y="-11" width="40" height="22" rx="4"/>
              <path d="M-14 5V-2M-7 5V-6M0 5V1M7 5V-4M14 5V-7"/>
            </g>
            <g id="scene-citation-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-14" y="-12" width="28" height="24" rx="4"/>
              <path d="M-5-6H-8V6H-5M5-6H8V6H5M0-5V5"/>
            </g>
          </defs>
          <ellipse cx="500" cy="165" rx="480" ry="155" fill="url(#scene-halo)"/>
          <g class="scene-wires">
            <path d="M390 90V110"/>
            <path d="M655 90V110"/>
            <path class="scene-source-results" d="M230 139H285"/>
            <path class="scene-query-wire" d="M285 162H230"/>
            <path d="M495 148H550"/>
            <path d="M760 148H795"/>
            <path class="scene-citation-flow" d="M390 185V210"/>
            <path d="M655 185V210"/>
            <path d="M760 230H777V174H795"/>
          </g>
          <g data-scene-stage="agents">
            <g class="scene-wires">
              <path d="M230 54H285"/>
              <path d="M760 54H795"/>
              <path class="scene-context-return" d="M890 90V100H775V72H760"/>
            </g>
            <rect class="scene-node" x="285" y="20" width="475" height="70" rx="10"/>
            <rect class="scene-card-light" x="285" y="20" width="475" height="70" rx="10"/>
            <text class="scene-label" x="303" y="46">Task coordination</text>
            <text class="scene-caption" x="303" y="76">Agents + execution harness</text>
            <rect class="scene-agent-task" x="538" y="31" width="95" height="35" rx="7"/>
            <rect class="scene-agent-task" x="648" y="31" width="95" height="35" rx="7"/>
            <text class="scene-caption" x="560" y="54">Task A</text>
            <text class="scene-caption" x="670" y="54">Task B</text>
            <rect class="scene-node" x="795" y="20" width="190" height="70" rx="10"/>
            <text class="scene-label" x="809" y="46">Working context</text>
            <text class="scene-caption" x="809" y="76">Task + findings</text>
          </g>
          <g data-scene-stage="sources">
            <rect class="scene-node" x="20" y="20" width="210" height="230" rx="12"/>
            <rect class="scene-card-light" x="20" y="20" width="210" height="230" rx="12"/>
            <g class="scene-symbol" transform="translate(38 26)">
              <path d="M5 3H20L25 8V24H5ZM20 3V9H25M0 8V28H19M10 14H20M10 19H18"/>
            </g>
            <text class="scene-label" x="77" y="47">Inputs</text>
            <rect class="scene-source-row" x="30" y="66" width="190" height="37" rx="6"/>
            <rect class="scene-source-row" x="30" y="128" width="190" height="37" rx="6"/>
            <rect class="scene-source-row" x="30" y="190" width="190" height="37" rx="6"/>
            <text class="scene-caption" x="38" y="90">Requests &amp; goals</text>
            <text class="scene-caption" x="38" y="152">Data &amp; documents</text>
            <text class="scene-caption" x="38" y="214">Tools &amp; services</text>
          </g>
          <g data-scene-stage="retrieve">
            <rect class="scene-node" x="285" y="110" width="210" height="75" rx="10"/>
            <rect class="scene-card-light" x="285" y="110" width="210" height="75" rx="10"/>
            <g class="scene-symbol" transform="translate(303 121)">
              <circle cx="11" cy="10" r="9"/>
              <path d="M18 17L27 26"/>
            </g>
            <text class="scene-label" x="343" y="142">Retrieval</text>
            <text class="scene-caption" x="303" y="169">Optional knowledge</text>
          </g>
          <g data-scene-stage="synthesize">
            <rect class="scene-node" x="550" y="110" width="210" height="75" rx="10"/>
            <rect class="scene-card-light" x="550" y="110" width="210" height="75" rx="10"/>
            <g class="scene-symbol" transform="translate(568 121)">
              <path d="M0 2L12 12L0 24M12 12H27M21 6L27 12L21 18"/>
            </g>
            <text class="scene-label" x="608" y="142">Tool use</text>
            <text class="scene-caption" x="568" y="169">Reason + execute</text>
          </g>
          <g data-scene-stage="attribute">
            <rect class="scene-node" x="285" y="210" width="475" height="40" rx="10"/>
            <rect class="scene-card-light" x="285" y="210" width="475" height="40" rx="10"/>
            <text class="scene-label" x="303" y="237">Provenance</text>
            <text class="scene-caption" x="438" y="237">Source links when relevant</text>
          </g>
          <g>
            <rect class="scene-tool" x="795" y="110" width="190" height="105" rx="12"/>
            <rect class="scene-answer-light" x="795" y="110" width="190" height="105" rx="12"/>
            <text class="scene-label" x="812" y="140">Results</text>
            <text class="scene-caption" x="812" y="168">Answers &amp; analyses</text>
            <text class="scene-caption" x="812" y="193">Summaries &amp; actions</text>
            <g class="scene-symbol scene-answer-symbol" transform="translate(947 122)">
              <path d="M0 0H22V23H0ZM5 6H17M5 11H17M5 16H12"/>
            </g>
            <path class="scene-answer-check" pathLength="1" d="M957 202L964 209L979 193"/>
          </g>
          <g data-scene-stage="evaluate">
            <path class="scene-evaluation-wire" d="M760 80H770V95H992V295H985M390 250V270M890 215V270"/>
            <rect class="scene-node" x="20" y="270" width="965" height="50" rx="12"/>
            <rect class="scene-card-light" x="20" y="270" width="965" height="50" rx="12"/>
            <path class="scene-rule" d="M246 296V313M473 296V313M731 296V313"/>
            <text class="scene-label" x="38" y="289">Evaluation</text>
            <text class="scene-caption" x="38" y="308">Task success</text>
            <text class="scene-caption" x="265" y="308">Tool results</text>
            <text class="scene-caption" x="492" y="308">Quality &amp; latency</text>
            <text class="scene-caption" x="750" y="308">Execution traces</text>
          </g>
          <g class="scene-tokens">
            <g class="scene-token scene-token-document" data-scene-path="sources"><use href="#scene-document-token"/></g>
            <g class="scene-token scene-token-task" data-scene-path="agents"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-vector" data-scene-path="retrieve"><use href="#scene-vector-token"/></g>
            <g class="scene-token scene-token-query" data-scene-path="retrieve"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-evidence" data-scene-path="retrieve"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-answer" data-scene-path="synthesize"><use href="#scene-document-token"/></g>
            <g class="scene-token scene-token-citation" data-scene-path="attribute"><use href="#scene-citation-token"/></g>
            <g class="scene-token scene-token-trace" data-scene-path="evaluate"><use href="#scene-chunk-token"/></g>
          </g>
        </svg>
        <div class="scene-node-controls" data-scene-controls role="group" aria-label="Explore AI task workflow stages" hidden>
          <button
            class="scene-hit scene-hit-sources"
            type="button"
            data-scene-select="sources"
            aria-pressed="true"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore task inputs and resources</span>
          </button>
          <button
            class="scene-hit scene-hit-retrieve"
            type="button"
            data-scene-select="retrieve"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore optional knowledge retrieval</span>
          </button>
          <button class="scene-hit scene-hit-agents" type="button" data-scene-select="agents" aria-pressed="false" aria-controls="scene-description">
            <span class="sr-only">Explore agents and harness support</span>
          </button>
          <button
            class="scene-hit scene-hit-synthesize"
            type="button"
            data-scene-select="synthesize"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore tools and reasoning</span>
          </button>
          <button
            class="scene-hit scene-hit-attribute"
            type="button"
            data-scene-select="attribute"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore provenance and source attribution</span>
          </button>
          <button
            class="scene-hit scene-hit-evaluate"
            type="button"
            data-scene-select="evaluate"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore task success, quality, tools and execution traces</span>
          </button>
        </div>
      </div>
    </div>
    <div class="scene-inspector">
      <p class="scene-connection-key">Solid: task flow. Dashed: queries, context, and evaluation observations.</p>
      <div class="scene-description" id="scene-description" data-scene-description-panel aria-live="off" aria-atomic="true">
        <section data-scene-description="sources" aria-labelledby="scene-sources-title">
          <h3 id="scene-sources-title">Start with the task.</h3>
          <p>Define the goal and available inputs: requests, data, documents, tools, and services.</p>
        </section>
        <section data-scene-description="retrieve" aria-labelledby="scene-retrieve-title">
          <h3 id="scene-retrieve-title">Choose useful context.</h3>
          <p>Retrieve relevant knowledge when needed; not every task requires search or document evidence.</p>
        </section>
        <section data-scene-description="agents" aria-labelledby="scene-agents-title">
          <h3 id="scene-agents-title">Coordinate the work.</h3>
          <p>Give task agents relevant context, with a harness supporting model execution and tool use.</p>
        </section>
        <section data-scene-description="synthesize" aria-labelledby="scene-synthesize-title">
          <h3 id="scene-synthesize-title">Reason and use tools.</h3>
          <p>Combine context and tool results to produce answers, summaries, analyses, or task-appropriate actions.</p>
        </section>
        <section data-scene-description="attribute" aria-labelledby="scene-attribute-title">
          <h3 id="scene-attribute-title">Keep results inspectable.</h3>
          <p>Preserve relevant source links and tool records; connect factual claims to evidence when applicable.</p>
        </section>
        <section data-scene-description="evaluate" aria-labelledby="scene-evaluate-title">
          <h3 id="scene-evaluate-title">Inspect the whole run.</h3>
          <p>Inspect task success, output quality, tool behavior, execution traces, and responsiveness.</p>
        </section>
      </div>
    </div>
  </div>
</section>
