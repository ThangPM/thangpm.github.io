<section
  class="hero-scene workbench"
  data-document-scene
  data-active-stage="sources"
  data-running="false"
  aria-labelledby="scene-heading"
>
  <div class="scene-heading">
    <div>
      <p class="section-label">Retrieval, agents &amp; evaluation</p>
      <h2 id="scene-heading">From sources to grounded answers</h2>
    </div>
  </div>
  <div class="scene-body">
    <div
      class="scene-viewport"
      tabindex="0"
      role="region"
      aria-label="Conceptual document intelligence diagram; scroll horizontally on small screens"
    >
      <div class="scene-canvas">
        <svg class="scene-illustration workbench-illustration" viewBox="0 -100 1000 610" aria-hidden="true" focusable="false">
          <defs>
            <radialGradient id="scene-halo">
              <stop offset="0" stop-color="currentColor" stop-opacity=".2"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </radialGradient>
            <linearGradient id="scene-card-light" x2="1" y2="1">
              <stop stop-color="currentColor" stop-opacity=".1"/>
              <stop offset="1" stop-color="currentColor" stop-opacity="0"/>
            </linearGradient>
            <linearGradient id="scene-surface" x1="0" y1="0" x2="0" y2="1">
              <stop stop-color="currentColor" stop-opacity=".1"/>
              <stop offset="1" stop-color="currentColor" stop-opacity=".015"/>
            </linearGradient>
            <marker id="scene-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse">
              <path d="M1 1L9 5L1 9" class="scene-arrowhead"/>
            </marker>
            <g id="scene-document-token" class="scene-token-drawing">
              <path class="scene-token-surface" d="M-10-14H4L10-8V14H-10ZM4-14V-8H10"/>
              <path d="M-5-3H5M-5 2H5M-5 7H2"/>
            </g>
            <g id="scene-chunk-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-17" y="-10" width="34" height="20" rx="4"/>
              <path d="M-11-3H11M-11 3H5"/>
            </g>
            <g id="scene-vector-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-20" y="-11" width="40" height="22" rx="4"/>
              <path d="M-14 5V-2M-7 5V-6M0 5V1M7 5V-4M14 5V-7"/>
            </g>
            <g id="scene-citation-token" class="scene-token-drawing">
              <rect class="scene-token-surface" x="-14" y="-12" width="28" height="24" rx="4"/>
              <path d="M-5-6H-8V6H-5M5-6H8V6H5M0-5V5"/>
            </g>
          </defs>
          <ellipse cx="500" cy="250" rx="480" ry="230" fill="url(#scene-halo)"/>
          <g class="scene-wires">
            <path d="M390 83V112"/>
            <path d="M655 83V112"/>
            <path class="scene-source-results" d="M230 174H285"/>
            <path class="scene-query-wire" d="M285 190H230"/>
            <path d="M390 200V258"/>
            <path d="M495 302H525V156H550"/>
            <path d="M655 200V258"/>
            <path d="M760 302H777V251H795"/>
            <path class="scene-citation-flow" d="M495 302H550"/>
          </g>
          <g data-scene-stage="agents">
            <g class="scene-wires">
              <path d="M230-48H285"/>
              <path d="M760-48H795"/>
              <path d="M655-15V18"/>
              <path class="scene-context-return" d="M890-15V0H775V-36H760"/>
            </g>
            <rect class="scene-node" x="20" y="-80" width="210" height="65" rx="10"/>
            <text class="scene-label" x="38" y="-48">Task routing</text>
            <text class="scene-caption" x="38" y="-25">Question + context</text>
            <rect class="scene-node" x="285" y="-80" width="475" height="65" rx="10"/>
            <text class="scene-label" x="303" y="-48">Task agents</text>
            <text class="scene-caption" x="303" y="-25">Coordinated tasks</text>
            <rect class="scene-agent-task" x="480" y="-67" width="115" height="39" rx="7"/>
            <rect class="scene-agent-task" x="622" y="-67" width="115" height="39" rx="7"/>
            <text class="scene-caption" x="508" y="-42">Task A</text>
            <text class="scene-caption" x="650" y="-42">Task B</text>
            <rect class="scene-node" x="795" y="-80" width="190" height="65" rx="10"/>
            <text class="scene-label" x="809" y="-48">Shared context</text>
            <text class="scene-caption" x="809" y="-25">Findings + state</text>
            <rect class="scene-node" x="285" y="18" width="475" height="65" rx="10"/>
            <rect class="scene-card-light" x="285" y="18" width="475" height="65" rx="10"/>
            <text class="scene-label" x="303" y="46">Harness execution</text>
            <text class="scene-caption" x="303" y="70">Model + tools + context</text>
            <g class="scene-symbol">
              <path d="M615 34H742V67H615Z"/>
              <text class="scene-caption" x="626" y="56">Model + tools</text>
            </g>
          </g>
          <g data-scene-stage="sources">
            <rect class="scene-node" x="20" y="112" width="210" height="234" rx="12"/>
            <rect class="scene-card-light" x="20" y="112" width="210" height="234" rx="12"/>
            <g class="scene-symbol" transform="translate(38 123)">
              <path d="M5 3H20L25 8V24H5ZM20 3V9H25M0 8V28H19M10 14H20M10 19H18"/>
            </g>
            <text class="scene-label" x="77" y="144">Sources</text>
            <path class="scene-rule" d="M38 159H212"/>
            <rect class="scene-source-row" x="30" y="168" width="190" height="37" rx="6"/>
            <rect class="scene-source-row" x="30" y="217" width="190" height="37" rx="6"/>
            <rect class="scene-source-row" x="30" y="266" width="190" height="37" rx="6"/>
            <text class="scene-caption" x="38" y="192">Documents</text>
            <text class="scene-caption" x="38" y="241">External collections</text>
            <text class="scene-caption" x="38" y="290">Via connectors</text>
          </g>
          <g data-scene-stage="retrieve">
            <rect class="scene-node" x="285" y="112" width="210" height="88" rx="10"/>
            <rect class="scene-card-light" x="285" y="112" width="210" height="88" rx="10"/>
            <g class="scene-symbol" transform="translate(303 124)">
              <circle cx="11" cy="10" r="9"/>
              <path d="M18 17L27 26"/>
            </g>
            <text class="scene-label" x="343" y="144">Retrieval</text>
            <text class="scene-caption" x="303" y="178">Embeddings + rank</text>
            <rect class="scene-node" x="285" y="258" width="210" height="88" rx="10"/>
            <rect class="scene-card-light" x="285" y="258" width="210" height="88" rx="10"/>
            <g class="scene-symbol" transform="translate(303 270)">
              <path d="M0 3H24V22H0ZM5 8H19M5 13H16M5 18H11"/>
            </g>
            <text class="scene-label" x="343" y="290">Evidence</text>
            <text class="scene-caption" x="303" y="324">Passages + sources</text>
          </g>
          <g data-scene-stage="synthesize">
            <rect class="scene-node" x="550" y="112" width="210" height="88" rx="10"/>
            <rect class="scene-card-light" x="550" y="112" width="210" height="88" rx="10"/>
            <g class="scene-symbol" transform="translate(568 124)">
              <path d="M0 2L12 12L0 24M12 12H27M21 6L27 12L21 18"/>
            </g>
            <text class="scene-label" x="608" y="144">Synthesis</text>
            <text class="scene-caption" x="568" y="178">Combine + qualify</text>
          </g>
          <g data-scene-stage="attribute">
            <rect class="scene-node" x="550" y="258" width="210" height="88" rx="10"/>
            <rect class="scene-card-light" x="550" y="258" width="210" height="88" rx="10"/>
            <g class="scene-symbol" transform="translate(568 270)">
              <path d="M11 16L7 20A6 6 0 0 1 0 12L7 5A6 6 0 0 1 15 5M12 9L16 5A6 6 0 0 1 24 13L17 20A6 6 0 0 1 9 20M7 16L17 6"/>
            </g>
            <text class="scene-label" x="608" y="290">Attribution</text>
            <text class="scene-caption" x="568" y="324">Claims &#8596; passages</text>
          </g>
          <g>
            <rect class="scene-tool" x="795" y="198" width="190" height="108" rx="12"/>
            <rect class="scene-answer-light" x="795" y="198" width="190" height="108" rx="12"/>
            <text class="scene-label" x="812" y="230">Grounded</text>
            <text class="scene-label" x="812" y="258">answer</text>
            <text class="scene-caption" x="812" y="288">Source citations</text>
            <g class="scene-symbol scene-answer-symbol" transform="translate(947 216)">
              <path d="M0 0H22V23H0ZM5 6H17M5 11H17M5 16H12"/>
            </g>
            <path class="scene-answer-check" pathLength="1" d="M947 257L954 264L969 248"/>
          </g>
          <g data-scene-stage="evaluate">
            <path class="scene-evaluation-wire" d="M760 51H992V445H985M390 346V400M890 306V400"/>
            <rect class="scene-node" x="20" y="400" width="965" height="90" rx="12"/>
            <rect class="scene-card-light" x="20" y="400" width="965" height="90" rx="12"/>
            <path class="scene-rule" d="M246 449V475M473 449V475M731 449V475"/>
            <text class="scene-label" x="38" y="432">Evaluation</text>
            <text class="scene-caption" x="38" y="466">Answers</text>
            <text class="scene-caption" x="265" y="466">Retrieval</text>
            <text class="scene-caption" x="492" y="466">Tool usage</text>
            <text class="scene-caption" x="750" y="466">Agent traces</text>
          </g>
          <g class="scene-tokens">
            <g class="scene-token scene-token-document" data-scene-path="sources"><use href="#scene-document-token"/></g>
            <g class="scene-token scene-token-task" data-scene-path="agents"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-vector" data-scene-path="retrieve"><use href="#scene-vector-token"/></g>
            <g class="scene-token scene-token-query" data-scene-path="retrieve"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-evidence" data-scene-path="retrieve"><use href="#scene-chunk-token"/></g>
            <g class="scene-token scene-token-answer" data-scene-path="synthesize"><use href="#scene-document-token"/></g>
            <g class="scene-token scene-token-citation" data-scene-path="attribute"><use href="#scene-citation-token"/></g>
            <g class="scene-token scene-token-trace" data-scene-path="evaluate"><use href="#scene-chunk-token"/></g>
          </g>
        </svg>
        <div class="scene-node-controls" data-scene-controls role="group" aria-label="Explore document intelligence stages" hidden>
          <button
            class="scene-hit scene-hit-sources"
            type="button"
            data-scene-select="sources"
            aria-pressed="true"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore sources and connectors</span>
          </button>
          <button
            class="scene-hit scene-hit-retrieve"
            type="button"
            data-scene-select="retrieve"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore retrieval and evidence</span>
          </button>
          <button class="scene-hit scene-hit-agents" type="button" data-scene-select="agents" aria-pressed="false" aria-controls="scene-description">
            <span class="sr-only">Explore agents and harness support</span>
          </button>
          <button
            class="scene-hit scene-hit-synthesize"
            type="button"
            data-scene-select="synthesize"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore answer synthesis</span>
          </button>
          <button
            class="scene-hit scene-hit-attribute"
            type="button"
            data-scene-select="attribute"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore source attribution</span>
          </button>
          <button
            class="scene-hit scene-hit-evaluate"
            type="button"
            data-scene-select="evaluate"
            aria-pressed="false"
            aria-controls="scene-description"
          >
            <span class="sr-only">Explore answer, retrieval, tool and trace evaluation</span>
          </button>
        </div>
      </div>
    </div>
    <div class="scene-inspector">
      <p class="scene-connection-key">Solid arrows: task flow and evidence. Dashed arrows: queries, shared context, and evaluation observations.</p>
      <div class="scene-description" id="scene-description" data-scene-description-panel aria-live="off" aria-atomic="true">
        <section data-scene-description="sources" aria-labelledby="scene-sources-title">
          <h3 id="scene-sources-title">Give knowledge a source.</h3>
          <p>Bring documents, external collections, and connected content into a source-aware evidence foundation.</p>
        </section>
        <section data-scene-description="retrieve" aria-labelledby="scene-retrieve-title">
          <h3 id="scene-retrieve-title">Build the evidence context.</h3>
          <p>Retrieve accessible passages, select what fits the context budget, and preserve source references.</p>
        </section>
        <section data-scene-description="agents" aria-labelledby="scene-agents-title">
          <h3 id="scene-agents-title">Coordinate the work.</h3>
          <p>Give task agents relevant context and shared findings, with a harness supporting model execution and tool use.</p>
        </section>
        <section data-scene-description="synthesize" aria-labelledby="scene-synthesize-title">
          <h3 id="scene-synthesize-title">Turn evidence into an answer.</h3>
          <p>Build a coherent response from evidence, qualifying conflicts and missing context.</p>
        </section>
        <section data-scene-description="attribute" aria-labelledby="scene-attribute-title">
          <h3 id="scene-attribute-title">Make claims inspectable.</h3>
          <p>Connect answer claims to supporting passages and available source locations.</p>
        </section>
        <section data-scene-description="evaluate" aria-labelledby="scene-evaluate-title">
          <h3 id="scene-evaluate-title">Inspect the whole run.</h3>
          <p>Inspect answer quality, retrieval, tool failures, and execution traces to understand reliability and responsiveness.</p>
        </section>
      </div>
    </div>
  </div>
</section>
