---
layout: default
---
<div class="post profile-home">
  <header class="profile-hero" data-ambient-running="false">
    {% include model-core.liquid %}
    <div>
      <p class="section-label">{{ page.subtitle }}</p>
      <h1 class="profile-name">
        {{ site.first_name }}
        {{ site.middle_name }}
        {{ site.last_name }}
      </h1>
      <p class="profile-headline">{{ page.headline }}</p>
      <p class="profile-intro">{{ page.intro }}</p>
      <div class="profile-actions" aria-label="Connect and explore">
        <a class="profile-link profile-link-primary" href="{{ '/publications/' | relative_url }}"
          >Explore research <span aria-hidden="true">&rarr;</span></a
        >
        <a class="profile-link" href="mailto:{{ site.email }}"><i class="fa-solid fa-envelope" aria-hidden="true"></i> Email</a>
        <a class="profile-link" href="https://www.linkedin.com/in/{{ site.linkedin_username }}/"
          ><i class="fa-brands fa-linkedin" aria-hidden="true"></i> LinkedIn</a
        >
        <a class="profile-link" href="https://github.com/{{ site.github_username }}"><i class="fa-brands fa-github" aria-hidden="true"></i> GitHub</a>
        {% if site.scholar_userid %}
          <a class="profile-link" href="https://scholar.google.com/citations?user={{ site.scholar_userid }}"
            ><i class="ai ai-google-scholar" aria-hidden="true"></i> Google Scholar</a
          >
        {% endif %}
      </div>
    </div>
    {% if page.profile.image %}
      <div class="profile-identity">
        {% assign profile_image_path = page.profile.image | prepend: 'assets/img/' %}
        {%
          include figure.liquid loading="eager" path=profile_image_path class="img-fluid"
          sizes="(max-width: 991px) 96px, 112px" width="112" height="112" alt=page.profile.image_alt cache_bust=true
        %}
        <p>
          ML engineer.<br>
          AI researcher. Systems builder.
        </p>
      </div>
    {% endif %}
  </header>

  {% include document-intelligence.liquid %}

  <section class="profile-section" aria-labelledby="approach-heading">
    <h2 id="approach-heading">How I work</h2>
    <div class="profile-grid approach-grid">
      {% for item in page.approach %}
        <article class="approach-principle">
          <span class="principle-emblem" aria-hidden="true">
            <svg viewBox="0 0 48 48" focusable="false">
              {% case forloop.index %}
                {% when 1 %}
                  <rect class="principle-emblem-fill" x="6" y="6" width="14" height="14" rx="4"/>
                  <rect x="28" y="28" width="14" height="14" rx="4"/>
                  <path d="M20 13H29A6 6 0 0 1 35 19V28M28 35H19A6 6 0 0 1 13 29V20M30 23L35 28L40 23"/>
                  <path d="M10 13L12 15L16 11M32 35H38"/>
                {% when 2 %}
                  <path class="principle-emblem-fill" d="M18 6H30V10H28V21L39 37A3 3 0 0 1 36 42H12A3 3 0 0 1 9 37L20 21V10H18Z"/>
                  <path d="M17 28H31M19 35L23 38L30 31M20 10H28"/>
                {% when 3 %}
                  <rect class="principle-emblem-fill" x="7" y="7" width="23" height="23" rx="5"/>
                  <rect x="18" y="18" width="23" height="23" rx="5"/>
                  <path d="M18 24H30M24 18V30M12 13H19M29 35H36"/>
              {% endcase %}
            </svg>
          </span>
          <h3>{{ item.title }}</h3>
          <p>{{ item.description }}</p>
        </article>
      {% endfor %}
    </div>
  </section>

  <section class="profile-section profile-biography" aria-label="Background">
    <div class="biography-copy">
      {{ content }}
      <a class="profile-text-link" href="{{ '/cv/' | relative_url }}">Experience & education <span aria-hidden="true">&rarr;</span></a>
    </div>
    <aside class="profile-journey" aria-labelledby="journey-heading">
      <p class="section-label">Research meets engineering</p>
      <h3 id="journey-heading">The path here</h3>
      <ol>
        {% for step in page.journey %}
          <li>
            <span class="journey-date">{{ step.date }}</span>
            <h4>{{ step.title }}</h4>
            <p>{{ step.detail }}</p>
          </li>
        {% endfor %}
      </ol>
      <a class="profile-text-link" href="{{ '/cv/' | relative_url }}">Full timeline <span aria-hidden="true">&rarr;</span></a>
    </aside>
  </section>

  <section class="profile-section" aria-labelledby="research-heading">
    <div class="profile-section-heading">
      <h2 id="research-heading">Selected publications</h2>
      <a class="profile-text-link" href="{{ '/publications/' | relative_url }}">All publications <span aria-hidden="true">&rarr;</span></a>
    </div>
    <div class="profile-grid research-grid">
      {% for paper in page.research %}
        <article class="profile-card research-card">
          <div class="card-visual card-visual-{{ paper.visual }}">
            <span class="research-topic">{{ paper.topic }}</span>
            {% include profile-visual.liquid visual=paper.visual %}
          </div>
          <div class="card-content">
            <p class="section-label">{{ paper.venue }}</p>
            <h3>
              <a href="{{ paper.url }}">{{ paper.title }}</a>
            </h3>
            <p>{{ paper.description }}</p>
            <a class="research-read" href="{{ paper.url }}" aria-label="Read the {{ paper.title }} paper"
              >Read paper <span aria-hidden="true">&#8599;</span></a
            >
          </div>
        </article>
      {% endfor %}
    </div>
  </section>

  {% if site.data.patents != blank %}
    <section class="profile-section" aria-labelledby="patents-heading">
      <h2 id="patents-heading">Patent applications</h2>
      {% include patent-applications.liquid items=site.data.patents %}
    </section>
  {% endif %}

  {% if page.news and site.announcements.enabled %}
    <section class="profile-section" aria-labelledby="news-heading">
      <h2 id="news-heading">Along the way</h2>
      {% include news.liquid limit=true %}
    </section>
  {% endif %}
  <script defer src="{{ '/assets/js/document-intelligence.js' | relative_url | bust_file_cache }}"></script>
</div>
